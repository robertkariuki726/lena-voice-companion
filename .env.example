# Copy this file to `.env` and fill in your API key.

# --- Required ---
# Get this from the Lena agent editor: Settings -> Developer / API Docs panel
# (the same panel shows the exact API base URL and full request reference).
BASE44_API_KEY=your_api_key_here

# --- Optional (sensible defaults) ---
# Lena's Superagent app id (already set to hers)
BASE44_AGENT_ID=6a0ebc236c3234fc81a8acf3

# API base URL (confirm in the agent editor's API docs panel)
BASE44_API_URL=https://app.base44.com

# Her voice — try en-US-JennyNeural (default), en-US-AriaNeural, en-GB-SoniaNeural
# Full list: python -m edge_tts --list-voices
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+0%

# Local speech-to-text model: tiny (fastest) | base (default) | small (most accurate)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

SAMPLE_RATE=16000
